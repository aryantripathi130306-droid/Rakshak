# ─────────────────────────────────────────────────────────────────────────────
# Rakshak v3.0 — Production & Staging Environment Configuration Template
# Forensic Digital Evidence & Cross-Case Syndicate Intelligence Platform
# ─────────────────────────────────────────────────────────────────────────────
# IMPORTANT: Copy this file to .env.production or .env.local and populate
# with cryptographically secure, environment-specific values.
# NEVER commit production secrets or real service credentials to source control.
# ─────────────────────────────────────────────────────────────────────────────

# [Application Runtime & Network Origin]
NODE_ENV=production
PORT=3000
APP_ORIGIN=https://rakshak.law-enforcement.internal

# [Database Connection]
# SQLite (Staging / Development Sandbox):
DATABASE_URL="file:./dev.db"
# PostgreSQL (Production Scaled Clustered Deployment):
# DATABASE_URL="postgresql://rakshak_app_user:REPLACE_WITH_SECURE_PASSWORD@postgres.internal:5432/rakshak_prod?schema=public&sslmode=prefer"

# [Authentication & Session Hardening]
# STRICT_AUTH=true enforces cryptographic bearer token or session cookie validation.
# When true, anonymous demo-mode officer bypass is completely disabled.
STRICT_AUTH=true

# Cryptographically random 64-character secret for signing sessions and tokens
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=REPLACE_WITH_64_BYTE_HEX_SESSION_SIGNING_SECRET

# Session Time-To-Live in hours (standard 8-12 hours for law-enforcement workstations)
SESSION_TTL_HOURS=12

# [Forensic Evidence Cold Storage]
# Content-addressed immutable evidence binary storage path
EVIDENCE_STORAGE_PATH=./uploads/raw
MAX_UPLOAD_SIZE_MB=100

# [On-Premises OCR Engine Configuration]
# Directory containing offline trained models (eng.traineddata)
TESSERACT_LANG_DIR=./
OCR_TIMEOUT_MS=15000
OCR_MAX_PAGES=50

# [Operational Backups & Audit Archival]
BACKUP_DIR=./backups
BACKUP_RETENTION_DAYS=30

# [Logging & Telemetry]
LOG_LEVEL=info
TRUST_PROXY=true
