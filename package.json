{
  "name": "rakshak",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "npm run prisma:generate && next build",
    "start": "next start",
    "prisma:generate": "prisma generate --schema=prisma/schema.prisma && prisma generate --schema=prisma/schema.postgresql.prisma",
    "db:seed": "node scripts/seed_dev_environment.mjs",
    "db:seed:dev": "node scripts/seed_dev_environment.mjs",
    "db:seed:test": "node scripts/seed_test_environment.mjs",
    "db:bootstrap-admin": "node scripts/bootstrap_admin.mjs",
    "db:clean-init": "node scripts/create_clean_deployment.mjs",
    "db:migrate": "prisma migrate dev",
    "db:reset": "prisma migrate reset --force",
    "db:provision:phase43": "node scripts/setup_phase43_test_db.mjs",
    "validate:release": "node scripts/run_release_validation_pipeline.mjs",
    "postinstall": "npm run prisma:generate"
  },
  "allowScripts": {
    "@prisma/client": true,
    "@prisma/engines": true,
    "prisma": true
  },
  "dependencies": {
    "@prisma/client": "^5.22.0",
    "@types/bcryptjs": "^2.4.6",
    "@types/jszip": "^3.4.0",
    "@types/pdf-parse": "^1.1.5",
    "@xyflow/react": "^12.11.6",
    "bcryptjs": "^3.0.3",
    "html2canvas": "^1.4.1",
    "jspdf": "^4.2.1",
    "jszip": "^3.10.2",
    "lucide-react": "^1.46.0",
    "next": "16.4.3",
    "pdf-parse": "^2.4.5",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "tesseract.js": "^7.0.0",
    "zod": "4.6.7"
  },
  "prisma": {
    "seed": "ts-node --compiler-options \"{\"module\":\"CommonJS\"}\" prisma/seed.ts"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "prisma": "^5.22.0",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
