// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Case {
  id              String          @id @default(uuid())
  caseNumber      String          @unique
  incidentType    String          // "Task_Scam" | "Digital_Arrest" | "Investment_Fraud" | "KYC_Freeze" | "Romance_Scam"
  complainantName String
  jurisdiction    String?
  status          String          @default("OPEN") // "OPEN" | "UNDER_INQUIRY" | "CHARGESHEETED" | "CLOSED"
  amountDefrauded Int?            // in INR
  description     String?         // case description / narrative
  firNumber       String?         // FIR or reference number
  officerName     String?         // assigned officer display name
  officerBadge    String?         // assigned officer badge / service number
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  evidence           Evidence[]
  timeline           TimelineEvent[]
  entities           CaseEntity[]
  clusterMemberships ClusterMembership[]
  legalMappings      CaseLegalMapping[]
  dossierAudits      DossierExportAudit[]
}

model Evidence {
  id               String          @id @default(uuid())
  caseId           String
  case             Case            @relation(fields: [caseId], references: [id], onDelete: Cascade)
  fileName         String
  fileType         String          // "PNG" | "TXT" | "PDF" | "MP3" ...
  mimeType         String
  fileSize         Int             // bytes
  sha256Hash       String          // server-computed, canonical truth
  clientHash       String          // client-supplied, verified against sha256Hash
  storagePath      String          // /uploads/raw/<sha256>.bin — immutable
  evidenceCategory String          @default("OTHER") // "CHAT" | "UPI_FINANCIAL" | "CALL_LOG" | "EMAIL" | "PHISHING_EMAIL" | "IDENTITY_DATA" | "DOCUMENT" | "CRIME_SCENE_PHOTO" | "AUDIO" | "VIDEO" | "URL_WEB" | "OTHER"
  metadata         String?         // JSON blob for category-specific metadata
  uploadedAt       DateTime        @default(now())

  facts            ExtractedFact[]
  timelineRefs     TimelineEvent[]
  transcriptions   Transcription[]
  chatTranslations ChatTranslation[]
  custodyEvents    CustodyEvent[]
}

model ExtractedFact {
  id                 String   @id @default(uuid())
  evidenceId         String
  evidence           Evidence @relation(fields: [evidenceId], references: [id], onDelete: Cascade)
  caseId             String

  factAssertion      String   // Human-readable summary of what was found
  entityType         String   // "UPI" | "PHONE" | "ACCOUNT" | "IFSC" | "DOMAIN" | "UTR" | "TELEGRAM" | "EMAIL" | "NAME" | "ADDRESS" | "IP" | "GPS_COORD"
  rawValue           String   // Original extracted string
  normalizedValue    String   // Canonical form (E.164 phone, lowercase UPI, etc.)
  confidence         Float    // 0.0–1.0
  sourceHash         String   // SHA-256 of source evidence (for chain of custody)
  verificationStatus String   @default("UNVERIFIED") // "UNVERIFIED" | "VERIFIED" | "DISPUTED"
  verifiedBy         String?

  // Bounding box coordinates as JSON: {"x":N,"y":N,"width":N,"height":N}
  boundingBox        String?  @default("{}")
  extractedAt        DateTime @default(now())
}

model TimelineEvent {
  id          String   @id @default(uuid())
  caseId      String
  case        Case     @relation(fields: [caseId], references: [id], onDelete: Cascade)
  evidenceId  String
  evidence    Evidence @relation(fields: [evidenceId], references: [id], onDelete: Cascade)

  timestamp   DateTime // UTC — canonical forensic timestamp
  description String
  sourceType  String   // "WHATSAPP" | "BANK_SMS" | "RECEIPT" | "CALL_LOG" | "SCREENSHOT"
  phase       String   @default("UNKNOWN") // "CONTACT" | "TRUST" | "PAYMENT" | "SEVERED" | "UNKNOWN"

  createdAt   DateTime @default(now())
}

model CaseEntity {
  id              String   @id @default(uuid())
  caseId          String
  case            Case     @relation(fields: [caseId], references: [id], onDelete: Cascade)
  entityType      String   // "UPI" | "PHONE" | "ACCOUNT" | "IFSC" | "DOMAIN" | "EMAIL" | "NAME" | "ADDRESS" | "IP" | "GPS_COORD"
  normalizedValue String   // Canonical form used for cross-case matching
  rawValue        String
  firstSeenAt     DateTime @default(now())

  // Ensures no duplicate entity per case
  @@unique([caseId, entityType, normalizedValue])
  // Index for fast cross-case queries
  @@index([normalizedValue])
  @@index([entityType, normalizedValue])
}

model Transcription {
  id                  String   @id @default(uuid())
  evidenceId          String
  evidence            Evidence @relation(fields: [evidenceId], references: [id], onDelete: Cascade)
  originalLanguage    String   @default("hi")
  originalText        String
  translatedText      String?
  targetLanguage      String?  @default("en")
  speakerCount        Int      @default(2)
  segments            String   // JSON string of TranscriptionSegment[]
  transcriptionMethod String   @default("WHISPER_AI")
  confidence          Float    @default(0.92)
  createdAt           DateTime @default(now())
}

model ChatTranslation {
  id                String   @id @default(uuid())
  evidenceId        String
  evidence          Evidence @relation(fields: [evidenceId], references: [id], onDelete: Cascade)
  originalLanguage  String   @default("hinglish")
  messages          String   // JSON string of ChatMessage[]
  translationMethod String   @default("INDIC_TRANS_AI")
  createdAt         DateTime @default(now())
}

model CaseCluster {
  id          String              @id @default(uuid())
  name        String
  theme       String?
  status      String              @default("ACTIVE") // "ACTIVE" | "ARCHIVED" | "MERGED"
  confidence  String              @default("POTENTIAL") // "POTENTIAL" | "PROBABLE" | "CONFIRMED"
  notes       String?
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt

  memberships ClusterMembership[]
}

model ClusterMembership {
  id        String      @id @default(uuid())
  clusterId String
  cluster   CaseCluster @relation(fields: [clusterId], references: [id], onDelete: Cascade)
  caseId    String
  case      Case        @relation(fields: [caseId], references: [id], onDelete: Cascade)
  addedAt   DateTime    @default(now())
  reason    String?

  @@unique([clusterId, caseId])
}

model CustodyEvent {
  id         String   @id @default(uuid())
  evidenceId String
  evidence   Evidence @relation(fields: [evidenceId], references: [id], onDelete: Cascade)
  eventType  String   // "INTAKE_UPLOAD" | "HASH_VERIFIED" | "EXTRACTION_COMPLETED" | "INTEGRITY_AUDIT" | "EVIDENCE_ACCESSED" | "EVIDENCE_DOWNLOADED" | "CUSTODY_TRANSFER" | "OFFICER_NOTE"
  actor      String   // e.g. "System Worker", "Inspector Rajesh Kumar (Badge #DL-CY-042)"
  action     String   // Human-readable description
  result     String   // "SUCCESS" | "VERIFIED" | "FAILED" | "WARNING"
  details    String?  // JSON string or notes
  timestamp  DateTime @default(now())

  @@index([evidenceId])
  @@index([timestamp])
}

model LegalProvision {
  id               String   @id @default(uuid())
  act              String   // "Bharatiya Nyaya Sanhita, 2023" | "Information Technology Act, 2000" | "Bharatiya Sakshya Adhiniyam, 2023"
  actCode          String   // "BNS" | "IT_ACT" | "BSA"
  section          String   // "§ 318(4)"
  title            String
  description      String
  offenceCategory  String?
  cognizable       Boolean  @default(true)
  bailable         Boolean  @default(false)
  sourceUrl        String?
  statutoryVersion String   @default("2023_OFFICIAL")
  verifiedDate     String?
  active           Boolean  @default(true)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
}

model CaseLegalMapping {
  id            String    @id @default(uuid())
  caseId        String
  case          Case      @relation(fields: [caseId], references: [id], onDelete: Cascade)
  sectionCode   String
  act           String
  section       String
  description   String
  relevance     String    @default("PRIMARY") // "PRIMARY" | "SECONDARY"
  status        String    @default("SUGGESTED") // "SUGGESTED" | "REVIEWED" | "APPROVED" | "REJECTED"
  rationale     String?
  reviewerName  String?
  reviewedAt    DateTime?
  reviewerNotes String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@unique([caseId, sectionCode])
  @@index([caseId])
}

model EvidenceLegalMapping {
  id         String   @id @default(uuid())
  caseId     String
  evidenceId String
  section    String
  relevance  String   @default("HIGH") // "HIGH" | "MEDIUM" | "LOW"
  rationale  String?
  status     String   @default("MAPPED")
  mappedBy   String?  @default("Inspector Rajesh Kumar (Badge #DL-CY-042)")
  createdAt  DateTime @default(now())

  @@unique([evidenceId, section])
  @@index([caseId])
  @@index([evidenceId])
}

model DossierExportAudit {
  id               String   @id @default(uuid())
  dossierNumber    String   @unique
  caseId           String
  case             Case     @relation(fields: [caseId], references: [id], onDelete: Cascade)
  exportFormat     String   // "PDF" | "JSON" | "ZIP"
  officerName      String
  officerBadge     String?
  templateVersion  String   @default("BSA_SEC63_V3")
  validationStatus String   // "COMPLETE" | "INCOMPLETE" | "REQUIRES_REVIEW"
  missingFields    String?  // JSON string
  evidenceCount    Int
  manifestHash     String?
  generatedAt      DateTime @default(now())

  @@index([caseId])
  @@index([generatedAt])
}

// ─── Phase 8: Officers, Authentication & RBAC ────────────────────────────────

model Officer {
  id           String    @id @default(uuid())
  badgeNumber  String    @unique // e.g. "DL-002"
  name         String    // e.g. "ACP Vikram Singh"
  email        String    @unique
  passwordHash String
  designation  String    // "ACP" | "Inspector" | "SI" | "Analyst" | "Head Constable"
  role         String    @default("INVESTIGATOR") // "ADMIN" | "INVESTIGATOR" | "ANALYST" | "VIEWER"
  jurisdiction String    // "Delhi" | "Mumbai" | "Bengaluru" | "Jaipur" | "Pune"
  unit         String?   @default("Cyber Crime Cell")
  status       String    @default("ACTIVE") // "ACTIVE" | "INACTIVE" | "SUSPENDED"
  lastLogin    DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  sessions     OfficerSession[]
  auditLogs    AuditLog[]
  reports      GeneratedReport[]

  @@index([badgeNumber])
  @@index([role])
}

model OfficerSession {
  id        String   @id @default(uuid())
  token     String   @unique
  officerId String
  officer   Officer  @relation(fields: [officerId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  revoked   Boolean  @default(false)
  ipAddress String?
  userAgent String?
  createdAt DateTime @default(now())

  @@index([token])
  @@index([officerId])
}

// ─── Phase 8: Centralized Audit Logging ───────────────────────────────────────

model AuditLog {
  id           String   @id @default(uuid())
  timestamp    DateTime @default(now())
  officerId    String?
  officer      Officer? @relation(fields: [officerId], references: [id], onDelete: SetNull)
  officerName  String   // e.g. "ACP Vikram Singh"
  officerBadge String?
  action       String   // "LOGIN_SUCCESS" | "LOGIN_FAILED" | "LOGOUT" | "GENERATE_REPORT" | "UPDATE_CASE" | "VIEW_EVIDENCE" | "EXPORT_JSON" | "VIEW_TIMELINE" | "ADD_OFFICER" | "UPDATE_ROLE" | "DEACTIVATE_OFFICER" | "ACCESS_DENIED"
  module       String   // "Auth" | "Cases" | "Evidence" | "Entities" | "Timeline" | "Syndicate" | "Legal" | "Reports" | "Officers"
  targetType   String?  // "Case" | "Evidence" | "Officer" | "Report"
  targetId     String?
  details      String   // Human readable event description
  result       String   @default("SUCCESS") // "SUCCESS" | "FAILED" | "BLOCKED"
  ipAddress    String?  @default("103.45.67.89")
  metadata     String?  // JSON string

  @@index([timestamp])
  @@index([officerId])
  @@index([action])
  @@index([module])
}

// ─── Phase 8: Report Generation & Scheduling ─────────────────────────────────

model GeneratedReport {
  id               String   @id @default(uuid())
  reportNumber     String   @unique // e.g. "RPT-2026-012"
  reportType       String   // "INVESTIGATION_COMPLETE" | "INVESTIGATION_SUMMARY" | "EVIDENCE_INTEGRITY" | "ENTITY_ANALYSIS" | "SYNDICATE_INTELLIGENCE" | "AUDIT_ACTIVITY"
  caseId           String?
  title            String
  generatedBy      String   // e.g. "ACP Vikram Singh"
  officerId        String?
  officer          Officer? @relation(fields: [officerId], references: [id], onDelete: SetNull)
  status           String   @default("COMPLETED") // "COMPLETED" | "FAILED" | "PROCESSING"
  outputFormat     String   // "PDF" | "JSON"
  sectionsIncluded String   // JSON string array
  fileSizeBytes    Int?     @default(1048576)
  filePath         String?
  metadata         String?  // JSON string
  createdAt        DateTime @default(now())

  @@index([caseId])
  @@index([createdAt])
  @@index([reportType])
}

model ScheduledReport {
  id         String   @id @default(uuid())
  name       String   // e.g. "Weekly Case Summary", "High-Risk Entity Report", "Pending Reviews"
  reportType String
  frequency  String   // "DAILY" | "WEEKLY" | "MONTHLY"
  nextRun    DateTime
  status     String   @default("ACTIVE") // "ACTIVE" | "PAUSED"
  recipients String?  // JSON string
  createdAt  DateTime @default(now())
}

